# Only ship the site and the assets used by its current pages.
*
!/.gitignore
!/.nojekyll
!/.agents/
!/.agents/skills/
!/.agents/skills/poem-studio-editorial/
!/.agents/skills/poem-studio-editorial/SKILL.md
!/*.html
!/*.css
!/*.js
!/assets/
/assets/*
!/assets/OFL.txt
!/assets/display.ttf
!/assets/mark.svg
!/assets/poem-*.webp
!/assets/portfolio/
!/assets/portfolio/*.webp
!/assets/portfolio/shenwan-motion.gif
!/assets/cover/
!/assets/cover/*.webp
!/assets/three.module.min.js
!/assets/three-LICENSE.txt
!/assets/about-yichun-daylight.webp
!/assets/decor-*.webp
!/assets/portrait-knit-original-face.webp
!/assets/portrait-plaid-original-face.webp
!/assets/portrait-cape-side-original.webp
!/assets/piece-*.webp
!/assets/look-cutouts/
!/assets/look-cutouts/*.webp
!/assets/look-cutouts/flats/
!/assets/look-cutouts/flats/*.webp
